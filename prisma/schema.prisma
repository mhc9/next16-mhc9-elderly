// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
//    url      = env("DATABASE_URL")
}

// --- Authentication Models (NextAuth.js) ---

model Account {
    id                 String   @id @default(cuid())
    user_id            String
    type               String
    provider           String
    provider_account_id String
    refresh_token      String?  @db.Text
    access_token       String?  @db.Text
    expires_at         Int?
    token_type         String?
    scope              String?
    id_token           String?  @db.Text
    session_state      String?

    user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@unique([provider, provider_account_id])
    @@map("accounts")
}

model Session {
    id                  String   @id @default(cuid())
    session_token       String   @unique
    user_id             String
    expires             DateTime
    user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

    @@map("sessions")
}

model User {
    id                  String    @id @default(cuid())
    name                String?
    email               String?   @unique
    email_verified      DateTime?
    image               String?
    password            String?
    role                Role      @default(USER)
    accounts            Account[]
    sessions            Session[]

    // Relations to Health Center (linked via hcode)
    hcode               String?
    hospital            Hospital? @relation(fields: [hcode], references: [hcode])
    
    @@map("users")
}

enum Role {
    USER
    ADMIN
    SUPERADMIN
}

model VerificationToken {
    identifier          String
    token               String   @unique
    expires             DateTime

    @@unique([identifier, token])
    @@map("verification_tokens")
}

// --- Geographical Models (Standardized to English) ---

model Province {
    id                  Int        @id @default(autoincrement())
    name                String?    @db.VarChar(200)
    name_en             String?    @db.VarChar(200)
    short               String?    @db.VarChar(200)
    short_en            String?    @db.VarChar(100)
    region_id           Int

    subdistricts        Subdistrict[]
    districts           District[]
    hospitals           Hospital[]
    persons             Person[]

    @@map("provinces")
}

model District {
    id                  Int           @id
    name                String?       @db.VarChar(200)
    province_id         Int?          
    district_code       String?       @db.VarChar(200)

    provinces           Province?     @relation(fields: [province_id], references: [id])
    subdistricts        Subdistrict[]
    hospitals           Hospital[]
    persons             Person[]

    @@map("districts")
}

model Subdistrict {
    id                  Int            @id @default(autoincrement())
    name                String?        @db.VarChar(200)
    province_id         Int?           
    district_id         Int?           
    subdistrict_code    String?
     
    province            Province?      @relation(fields: [province_id], references: [id])
    district            District?      @relation(fields: [district_id], references: [id])
    hospitals           Hospital[]
    persons             Person[]

    @@map("subdistricts")
}

// --- Health Center & Reporting Models ---

model Hospital {
    hcode               String        @id @db.VarChar(9) // Primary Key: 5-digit code
    name                String        @db.VarChar(255)
    hospital_type_id    Int?
    address             String?       @db.Text
    moo                 Int?
    subdistrict_id      Int?          
    district_id         Int?
    province_id         Int?           
    region_id           Int?
    phone               String?

    subdistrict         Subdistrict?  @relation(fields: [subdistrict_id], references: [id])
    province            Province?     @relation(fields: [province_id], references: [id])
    district            District?     @relation(fields: [district_id], references: [id])

    users               User[]
    persons             Person[]
    summaryReports      SummaryReport[]

    @@map("hospitals")
}

model SummaryReport {
    id                  Int    @id @default(autoincrement())
    year                Int    // e.g., 2568, 2569
    hcode               String

    // Aggregate totals matching Excel columns
    target_population   Int    @default(0) // N (คน)
    screened_total      Int    @default(0) // จำนวนที่ได้รับการคัดกรองทั้งหมด (n)
    screened_normal     Int    @default(0) // ปกติ
    screened_risk       Int    @default(0) // เสี่ยง

    // Care Round 1
    care_total          Int    @default(0) // จำนวนที่ได้รับดูแลช่วยเหลือทั้งหมด
    assess_9q_normal    Int    @default(0) // 9Q ปกติ
    assess_9q_risk      Int    @default(0) // 9Q เสี่ยง (>=7)
    assess_8q_normal    Int    @default(0) // 8Q ปกติ
    assess_8q_risk      Int    @default(0) // 8Q เสี่ยง (>=1)
    care_counseling     Int    @default(0) // ให้คำปรึกษา/ดูแลสังคมจิตใจ
    care_referral       Int    @default(0) // ส่งต่อ

    // Round 2 (Follow-up)
    followup_normal     Int    @default(0) // 2Q plus ซ้ำ ปกติ
    followup_risk_q12   Int    @default(0) // 2Q plus ซ้ำ เสี่ยง Q1/Q2
    followup_risk_q3    Int    @default(0) // 2Q plus ซ้ำ เสี่ยง Q3

    created_at          DateTime @default(now())
    updated_at          DateTime @updatedAt

    hospital            Hospital @relation(fields: [hcode], references: [hcode])

    @@unique([year, hcode])
    @@map("summary_reports")
}

// --- Individual Case Management ---

model Person {
    pid                Int          @id @default(autoincrement())
    cid                String?      @unique @db.VarChar(13) // Thai National ID
    prefix             String?      @db.VarChar(50)
    firstname          String       @db.VarChar(100)
    lastname           String       @db.VarChar(100)
    sex                String?      @db.VarChar(10)
    birth_date         DateTime?    @db.Date
    address            String?      @db.Text
    moo                Int?
    road               String?      @db.Text  
    subdistrict_id     Int?
    district_id        Int?
    province_id        Int? 
    zipcode            String?      @db.VarChar(10)
    telephone          String?      @db.VarChar(20)
    mobile             String?      @db.VarChar(20)
    email              String?      @db.VarChar(100)
    hcode              String       @db.VarChar(9)

    subdistrict        Subdistrict? @relation(fields: [subdistrict_id], references: [id])
    district           District?    @relation(fields: [district_id], references: [id])
    province           Province?    @relation(fields: [province_id], references: [id])
    hospital           Hospital     @relation(fields: [hcode], references: [hcode])
    screenings         Screening[]

    created_at         DateTime     @default(now())
    updated_at         DateTime     @updatedAt

    @@map("persons")
}

model Screening {
    id                 Int        @id @default(autoincrement())
    person_id          Int        

    // 2Q plus 1
    screen_date        DateTime   @default(now())
    q2_result          String     @default("NORMAL") @db.VarChar(50)

    // 2Q plus 2
    screen_date_2      DateTime?
    q2_result_2        String?    @db.VarChar(50)

    // 9Q & 8Q Details
    q9_score           Int?
    q9_result          Boolean?   // false=Normal, true=Risk (>=7)
    q8_score           Int?
    q8_result          Boolean?   // false=Normal, true=Risk (>=1)

    // Care Outcomes
    care_type          String?    @db.VarChar(255) // Counseling, Referral, etc.
    care_detail        String?    @db.Text
    care_date          DateTime?
    remark             String?    @db.Text
    year               Int
    created_at         DateTime   @default(now())
    updated_at         DateTime   @updatedAt

    person             Person     @relation(fields: [person_id], references: [pid])

    @@map("screenings")
}
